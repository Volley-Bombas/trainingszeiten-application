<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: Die Einträge (files/*.json) werden in die Google-Sicherung
     und bei der Übertragung auf ein neues Gerät mitgenommen. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
